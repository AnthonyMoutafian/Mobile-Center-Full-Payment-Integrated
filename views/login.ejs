<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login</title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <body>
    <nav class="navigation">
      <div class="container">
        <div class="nav-box">
          <div class="nav-left">
            <a href="/">
              <img
                src="https://www.mobilecentre.am/assets/img/logo.svg"
                alt="logo"
              />
            </a>
          </div>

          <div class="nav-center">
            <form action="/search" method="get">
              <input type="text" name="search" placeholder="Search" />
              <button type="submit">
                <i class="bi bi-search"></i>
              </button>
            </form>
          </div>

          <div class="nav-right">
          <% if(Object.keys(currentUser).length !== 0){%>
            <form action="/api/logout" method="post">
              <button type="submit" class="logoutBtn"><i class="bi bi-box-arrow-right"></i></button>
            </form>
            <a href="/orders">Orders</a>
            <a href="/favorites"><i class="bi bi-heart"></i></a>
          <%} else{%> 
            <a href="/api/login"><i class="bi bi-person"></i></a>
          <%}%>
            <a href="/cart"><i class="bi bi-cart"></i> <%=cartLength%></a>
          </div>
        </div>
      </div>
    </nav>

  <% if(Object.keys(currentUser).length !== 0){%>
    <p>You're Already Logged In !</p>
  <%} else{%> 
    <div class="container loginBoxFlex">
      <div class="loginBox">
        <div class="registerBoxInLogin">
          <h2>Login</h2>
          <a href="/api/register">Register</a>
        </div>
        <form class="formBoxLogin" action="/api/login" method="post">
          <label for="email">Email</label>
          <input placeholder="Enter Email" type="text" name="email" />
          <label for="password">Password</label>
          <input placeholder="Enter Password" type="password" name="password" />
          <button type="submit">Login</button>
        </form>
      </div>
    </div>
   <%}%>

    

    <footer class="footer">
      <div class="container">
        <div class="footerBox">
          <div class="footerLeft">
            <span>Mobile Center</span>
          </div>
          <div class="footerRight">
            <span>© 2026 MobileCentre Art LLC. All Rights Reserved. (AM)</span>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
