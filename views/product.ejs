<!DOCTYPE html>
<html lang="en">
<head>
  <title><%= title %></title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>

  <nav class="navigation">
    <div class="container">
      <div class="nav-box">
        <div class="nav-left">
          <a href="/">
            <img
              src="https://www.mobilecentre.am/assets/img/logo.svg"
              alt="Mobile Centre Logo"
            >
          </a>
        </div>

        <div class="nav-center">
          <form action="/search" method="get">
            <input type="text" name="search" placeholder="Search">
            <button type="submit">
              <i class="bi bi-search"></i>
            </button>
          </form>
        </div>

        <div class="nav-right">
          <% if(Object.keys(currentUser).length !== 0){%>
            <form action="/api/logout" method="post">
              <button type="submit" class="logoutBtn"><i class="bi bi-box-arrow-right"></i></button>
            </form>
            <a href="/orders">Orders</a>
            <a href="/favorites"><i class="bi bi-heart"></i></a>
          <%} else{%> 
            <a href="/api/login"><i class="bi bi-person"></i></a>
          <%}%>
          <a href="/cart"><i class="bi bi-cart"></i> <%=cartLength%></a>
        </div>
      </div>
    </div>
  </nav>

  <div class="container">
    <div class="product-page">

      <div class="product-image">
        <img
          src="<%= product.image %>"
          alt="<%= product.title %>"
        >
      </div>

      <div class="product-info">
        <div class="upperInfo">
          <h1><%= product.title %></h1>
          <% if(Object.keys(currentUser).length !== 0){%>
            <form class="productPageForm" action="<%= currentUser.favorites.some(fav => fav.id === product.id) ? '/favorites/' + product.id + '/delete' : '/favorites/' + product.id %>" method="post">
              <button type="submit" class="heartBtn">
                <i class="bi-heart <%= favorites.some(fav => fav.id === product.id) ? 'activeHeartTag' : 'heartTag' %>"></i>
              </button>
            </form>
            <%}%>
        </div>
        <h2><%= product.brand %></h2>

        <p>
            <i class="bi bi-star-fill"></i>
            <%= product.rating %>
        </p>

        <p class="price">
          Price:
          <strong><%= product.price.toLocaleString() %> AMD</strong>
        </p>

        <% if (product.isNew) { %>
          <span class="new-badge">NEW</span>
        <% } %>

        <div class="clear">
        </div>

        <% if (product.inStock > 0) { %>
          <p class="availabilityInfo">Available</p>
        <% } else { %>
          <p class="outofstockInfo">Out Of Stock</p>
        <% } %>
        
        <div class="clear">
        </div>

          
        

          <%if(product.inStock > 0){%>
            <form action="/cart/<%= product.id %>" method="post">
              <button type="submit" class="buyBtn">Buy</button>
            </form>
          <%} else{%>
            <button class="not-availableBtn">Not Available</button>
          <%}%>
      </div>

    </div>

    <hr>

    <h2>Specifications</h2>

    <div class="specifications">
      <% product.params.forEach(param => { %>
        <div class="spec">
          <strong><%= param.title %></strong>
          <span><%= param.desc %></span>
        </div>
      <% }) %>
    </div>

    <hr>

    <h2 class="related-title">Related Products</h2>

    <div class="products">
      <% relatedProducts.forEach(product => { %>
        <div
          class="product"
        >
          <a href="/product/<%= product.slug %>">
            <img
            src="<%= product.image %>"
            alt="<%= product.title %>"
          >
          </a>

          <h3><%= product.title %></h3>

          <p class="price">
            <%= product.price.toLocaleString() %> AMD
          </p>

          <%if(product.inStock > 0){%>
            <form action="/cart/<%= product.id %>" method="post">
              <button type="submit" class="buyBtn">Buy</button>
            </form>
          <%} else{%>
            <button class="not-availableBtn">Not Available</button>
          <%}%>
        </div>
      <% }) %>
    </div>

  </div>
  <footer class="footer">
      <div class="container">
          <div class="footerBox">
              <div class="footerLeft">
                <span>Mobile Center</span>
              </div>
              <div class="footerRight">
                <span>© 2026 MobileCentre Art LLC. All Rights Reserved. (AM)</span>
              </div>
          </div>
      </div>
  </footer>
</body>
</html>